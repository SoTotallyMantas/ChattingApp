# Garage service environment variables
# Admin Api token
# In garage cli use garage admin-token create to get token
GARAGE_ADMIN_TOKEN=Change_Me
# Metrics token ( Optional) 
GARAGE_METRICS_TOKEN=Change_Me
# Internal RPC Secret ( random 32-64 hex chars)
GARAGE_RPC_SECRET=Change_Me

# Garage S3 Bucket variables
# Bucket name used by backend
S3_BUCKET=voxlock-uploads
# Acces key ID created using Garage Admin UI 
S3_KEY_ID=Change_Me
# Access key name 
S3_KEY_NAME=backend-access
# Secret key generated by Garage
S3_KEY_SECRET=Change_Me

# Postgre data base environment variables
# User name to enter database (Default) 
POSTGRES_USER=voxuser
# User password to enter database (Default) 
POSTGRES_PASSWORD=voxpass
# Database name (Default)
POSTGRES_DB=voxlock
# ONNX Embedding model
# Mounted paths inside backend container (Don't change)
ONNX_MODEL_PATH=/models/all-MiniLM-L6-v2/model.onnx
ONNX_VOCAB_PATH=/models/all-MiniLM-L6-v2/vocab.txt

# pgAdmin environment variables
# pgAdmin (Default) login
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin

# Backend service environment variables
# JWT signing sercet ( min 32 bytes recommended)
JWT_SECRET=Change_Me

# MASTER KEY for encryptiond decryption BASE64 32 byte 
# Example generation: 
# openssl rand -base64 32
DATA_ENCRYPTION_MASTER_KEY=Change_me